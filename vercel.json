{
  "buildCommand": "npm run build:superadmin",
  "outputDirectory": "superadmin-web/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://naveen-chitfund-production.up.railway.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
