# ==============================================================================
# ChitTech Digital Chit-Fund Platform — Production Environment Configuration
# Target Compliance: Chit Funds Act 1982 • DPDP Act 2023 • RBI ROSCA Escrow Directives
# ==============================================================================

# --- Server & Runtime ---
PORT=4000
NODE_ENV=production
LOG_LEVEL=info

# --- PostgreSQL Relational Store (Integer-Paise Double-Entry Ledger) ---
# For managed PostgreSQL (AWS RDS, Supabase, Neon, Railway):
DATABASE_URL=postgres://chittech_admin:StrongPassword2026!@postgres.internal:5432/chittech?sslmode=require
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=25
DATABASE_TIMEOUT_MS=10000

# --- Redis In-Memory Auction Room Cache & Circular Feed ---
# Used for real-time reverse auction discount rate ordering & subscriber presence
REDIS_URL=redis://:RedisAuthSecret2026!@redis.internal:6379/0

# --- Authentication & Session Security ---
# Generate using: openssl rand -base64 64
JWT_SECRET=production_ultra_secure_jwt_secret_chittech_2026_finance_key
JWT_EXPIRES_IN=7d

# --- Razorpay Escrow & Installment Collection Gateway ---
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# --- SMS Gateway (OTP Verification & Statutory Notifications) ---
# Supported providers: mock | msg91 | twilio | kaleyra
SMS_PROVIDER=mock
MSG91_AUTH_KEY=
MSG91_SENDER_ID=CHTECH
MSG91_OTP_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Regulatory & Foreman Defaults ---
DEFAULT_FOREMAN_COMMISSION_PCT=5
STATUTORY_MAX_DISCOUNT_PCT=40
GST_FOREMAN_COMMISSION_RATE_PCT=18
FOREMAN_GSTIN=36AAACC1206K1ZF
FOREMAN_LEGAL_ENTITY="ChitTech Digital Chit Funds Private Limited"

# --- CORS & Networking ---
CORS_ORIGIN="https://chittech.com,https://app.chittech.com"

# --- Cloudinary Centralized Media & Document Storage ---
CLOUDINARY_CLOUD_NAME=chittech-cloud
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here
CLOUDINARY_SECURE=true
